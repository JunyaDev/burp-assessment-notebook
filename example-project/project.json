  "vulnerabilities": [
    {
      "id": "vuln-0001",
      "title": "Reflected XSS via search parameter q",
      "severity": "HIGH",
      "status": "CONFIRMED",
      "affectedUrl": "https://portal.acme.test/search?q=test",
      "affectedComponent": "search form, parameter q",
      "description": "The q parameter is reflected into the HTML response without output encoding, allowing script injection.",
      "technicalObservation": "A canary value appeared verbatim in HTML text context.",
      "stepsToReproduce": "1. Submit q=<script>alert(1)</script> on /search.\n2. Observe the script executes in the response.",
      "impact": "Session theft, actions performed as the victim.",
      "remediation": "Context-aware output encoding; a strict Content-Security-Policy.",
      "notes": "",
      "screenshotIds": [],
      "requestIds": [],
      "createdAt": "2026-09-23 17:44:33",
      "updatedAt": "2026-09-23 17:44:33"
    },
    {
      "id": "vuln-0002",
      "title": "Session cookie missing Secure attribute",
      "severity": "LOW",
      "status": "OPEN",
      "affectedUrl": "https://portal.acme.test/login",
      "affectedComponent": "",
      "description": "The session cookie is issued without the Secure attribute.",
      "technicalObservation": "",
      "stepsToReproduce": "",
      "impact": "",
      "remediation": "Set the Secure and HttpOnly attributes on session cookies.",
      "notes": "",
      "screenshotIds": [],
      "requestIds": [],
      "createdAt": "2026-09-23 17:44:33",
      "updatedAt": "2026-09-23 17:44:33"
    }
  ],
